<div class="max-w-lg mx-auto px-4 py-6">
  <h1 class="text-2xl md:text-3xl font-bold text-center mb-6" style="color: #F5D67A;">Activity Analysis</h1>

  <!-- Animal Selection - Vertical Cards -->
  <div class="space-y-3">
    <% @animals.each do |animal| %>
      <%= link_to activity_path(animal_slug: animal.slug),
          class: "flex items-center gap-4 p-3 rounded-xl transition-all hover:scale-[1.02]",
          style: "background-color: #6B5D4D;" do %>
        <div class="w-16 h-16 flex-shrink-0 overflow-hidden rounded-lg flex items-center justify-center" style="background-color: #5D4E37;">
          <%= image_tag "#{animal.slug}-icon.png",
              alt: animal.name,
              class: "w-12 h-12 object-contain" %>
        </div>
        <span class="text-lg font-semibold" style="color: #F5D67A;"><%= animal.name %></span>
      <% end %>
    <% end %>
  </div>
</div>
