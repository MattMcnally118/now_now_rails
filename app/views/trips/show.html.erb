<div class="max-w-lg mx-auto px-4 py-6">
  <!-- Header -->
  <h1 class="text-2xl font-bold text-center mb-6" style="color: #F5D67A;"><%= @trip.animal.name %> Trip</h1>

  <!-- Likelihood Score Card -->
  <div class="rounded-2xl shadow-lg p-6 mb-6 text-center" style="background-color: #6B5D4D;">
    <p class="text-sm mb-1" style="color: #D4C4B4;">Likelihood of seeing</p>
    <p class="text-5xl font-bold mb-2" style="color: #F5D67A;"><%= @trip.likelihood_score %>%</p>
    <p class="text-xs" style="color: #A89888;">
      <% if @trip.likelihood_score >= 80 %>
        Excellent viewing conditions expected
      <% elsif @trip.likelihood_score >= 60 %>
        Good chance of sighting
      <% elsif @trip.likelihood_score >= 40 %>
        Moderate chance of sighting
      <% else %>
        Challenging conditions - consider optimal timing
      <% end %>
    </p>
  </div>

  <!-- Recommended Location -->
  <div class="rounded-2xl shadow-lg p-6 mb-6" style="background-color: #6B5D4D;">
    <h3 class="text-lg font-semibold mb-4 flex items-center gap-2" style="color: #F5D67A;">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #F5D67A;">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      Recommended Location
    </h3>
    <% if @trip.recommended_latitude && @trip.recommended_longitude %>
      <div class="rounded-xl p-4 mb-4" style="background-color: #5D4E37;">
        <div class="flex justify-between text-sm mb-2">
          <span style="color: #A89888;">Coordinates</span>
          <span class="font-mono" style="color: #F5D67A;"><%= @trip.recommended_latitude.round(4) %>, <%= @trip.recommended_longitude.round(4) %></span>
        </div>
        <% if @trip.target_month || @trip.target_hour %>
          <div class="flex justify-between text-sm">
            <span style="color: #A89888;">Best Time</span>
            <span class="font-medium" style="color: #F5D67A;">
              <% if @trip.target_month && @trip.target_hour %>
                <%= Date::ABBR_MONTHNAMES[@trip.target_month] %> at <%= format('%02d:00', @trip.target_hour) %>
              <% elsif @trip.target_hour %>
                <%= format('%02d:00', @trip.target_hour) %>
              <% elsif @trip.target_hour %>
                <%= Date::MONTHNAMES[@trip.target_month] %>
              <% end %>
            </span>
          </div>
        <% end %>
      </div>
      <a href="https://www.google.com/maps/search/?api=1&query=<%= @trip.recommended_latitude %>,<%= @trip.recommended_longitude %>"
         target="_blank"
         class="flex items-center justify-center gap-2 w-full py-3 font-semibold rounded-xl shadow-md transition-all"
         style="background-color: #F5D67A; color: #3D3225;">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        Open in Google Maps
      </a>
    <% else %>
      <div class="text-center py-8" style="color: #A89888;">
        <p>No suitable location found</p>
        <p class="text-sm mt-1">Try expanding your search radius</p>
      </div>
    <% end %>
  </div>

  <!-- Actions -->
  <%= link_to new_trip_path, class: "block w-full py-3 text-center font-semibold rounded-xl shadow-md transition-all", style: "background-color: #F5D67A; color: #3D3225;" do %>
    Plan Another Trip
  <% end %>
</div>
