<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-center text-amber-800 mb-2">Trip Recommendation</h1>
  <hr class="border-amber-300 mb-6">

  <!-- Likelihood Score -->
  <div class="bg-gradient-to-r from-amber-500 to-orange-500 rounded-xl shadow-lg p-6 mb-6 text-white text-center">
    <p class="text-lg mb-2">Likelihood of seeing a <%= @trip.animal.name %></p>
    <p class="text-6xl font-bold"><%= @trip.likelihood_score %>%</p>
    <p class="text-amber-100 mt-2">
      Based on <%= @nearby_sightings.size %> historical sightings within <%= @trip.radius_km %>km
    </p>
  </div>

  <!-- Recommendation Details -->
  <div class="grid md:grid-cols-2 gap-6 mb-6">
    <!-- Recommended Location -->
    <div class="bg-white rounded-xl shadow-lg p-6 border border-amber-100">
      <h3 class="text-lg font-semibold text-amber-800 mb-4">Recommended Location</h3>
      <% if @trip.recommended_latitude && @trip.recommended_longitude %>
        <div class="space-y-3">
          <div class="flex justify-between">
            <span class="text-gray-600">Latitude:</span>
            <span class="font-mono font-medium"><%= @trip.recommended_latitude.round(6) %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Longitude:</span>
            <span class="font-mono font-medium"><%= @trip.recommended_longitude.round(6) %></span>
          </div>
          <hr class="my-2">
          <a href="https://www.google.com/maps/search/?api=1&query=<%= @trip.recommended_latitude %>,<%= @trip.recommended_longitude %>"
             target="_blank"
             class="block w-full text-center py-2 bg-amber-100 hover:bg-amber-200 text-amber-800 rounded-lg transition-all">
            Open in Google Maps
          </a>
        </div>
      <% else %>
        <p class="text-gray-500">No specific location could be determined</p>
      <% end %>
    </div>

    <!-- Your Search Parameters -->
    <div class="bg-white rounded-xl shadow-lg p-6 border border-amber-100">
      <h3 class="text-lg font-semibold text-amber-800 mb-4">Your Search</h3>
      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <%= image_tag "#{@trip.animal.slug}-icon.png", alt: @trip.animal.name, class: "w-8 h-8" %>
          <span class="font-medium"><%= @trip.animal.name %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Start Location:</span>
          <span class="font-medium"><%= @trip.start_latitude.round(4) %>, <%= @trip.start_longitude.round(4) %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Search Radius:</span>
          <span class="font-medium"><%= @trip.radius_km %> km</span>
        </div>
        <% if @trip.target_month %>
          <div class="flex justify-between">
            <span class="text-gray-600">Target Month:</span>
            <span class="font-medium"><%= Date::MONTHNAMES[@trip.target_month] %></span>
          </div>
        <% end %>
        <% if @trip.target_hour %>
          <div class="flex justify-between">
            <span class="text-gray-600">Target Hour:</span>
            <span class="font-medium"><%= format('%02d:00', @trip.target_hour) %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Scores Breakdown -->
  <div class="bg-white rounded-xl shadow-lg p-6 mb-6 border border-amber-100">
    <h3 class="text-lg font-semibold text-amber-800 mb-4">Score Breakdown</h3>
    <div class="grid grid-cols-2 gap-6">
      <div>
        <div class="flex justify-between mb-1">
          <span class="text-sm text-gray-600">Temporal Score (70%)</span>
          <span class="text-sm font-medium"><%= (@trip.temporal_score.to_f * 100).round %>%</span>
        </div>
        <div class="w-full bg-gray-100 rounded-full h-3">
          <div class="bg-amber-400 h-3 rounded-full" style="width: <%= (@trip.temporal_score.to_f * 100).round %>%"></div>
        </div>
      </div>
      <div>
        <div class="flex justify-between mb-1">
          <span class="text-sm text-gray-600">Spatial Score (30%)</span>
          <span class="text-sm font-medium"><%= (@trip.spatial_score.to_f * 100).round %>%</span>
        </div>
        <div class="w-full bg-gray-100 rounded-full h-3">
          <div class="bg-amber-400 h-3 rounded-full" style="width: <%= (@trip.spatial_score.to_f * 100).round %>%"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Notes -->
  <% if @trip.notes.present? %>
    <div class="bg-amber-50 rounded-xl p-6 mb-6 border border-amber-200">
      <h3 class="text-lg font-semibold text-amber-800 mb-3">Analysis Notes</h3>
      <ul class="space-y-2">
        <% @trip.notes.each do |note| %>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-amber-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-gray-700"><%= note %></span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Actions -->
  <div class="flex gap-4">
    <%= link_to new_trip_path, class: "flex-1 py-3 text-center bg-amber-500 hover:bg-amber-600 text-white font-semibold rounded-lg shadow-md transition-all" do %>
      Plan Another Trip
    <% end %>
    <%= link_to sightings_path, class: "flex-1 py-3 text-center bg-white hover:bg-gray-50 text-amber-800 font-semibold rounded-lg border border-amber-300 transition-all" do %>
      View on Map
    <% end %>
  </div>
</div>
