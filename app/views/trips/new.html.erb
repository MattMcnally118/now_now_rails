<div class="max-w-lg mx-auto px-4 py-6">
  <h1 class="text-2xl md:text-3xl font-bold text-center mb-6" style="color: #F5D67A;">Trip Planner</h1>

  <div class="rounded-2xl shadow-lg p-6" style="background-color: #6B5D4D;">
    <%= form_with model: @trip, local: true, class: "space-y-6" do |f| %>
      <% if @trip.errors.any? %>
        <div class="rounded-lg p-3 text-sm" style="background-color: #8B4513; color: #FFE9A0;">
          <% @trip.errors.full_messages.each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="rounded-lg p-3 text-sm" style="background-color: #7D6D5D; color: #F5D67A;">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <!-- Animal Selection - Text Buttons -->
      <div>
        <style>
          .select-btn input:checked + div { border-color: #F5D67A !important; color: #F5D67A !important; }
        </style>
        <label class="block text-sm font-semibold mb-3" style="color: #F5D67A;">Select Animal</label>
        <div class="flex flex-wrap gap-2">
          <% @animals.each do |animal| %>
            <label class="cursor-pointer select-btn">
              <input type="radio" name="trip[animal_id]" value="<%= animal.id %>"
                     class="peer hidden"
                     <%= 'checked' if @trip.animal_id == animal.id || (@trip.animal_id.nil? && animal == @animals.first) %>>
              <div class="px-4 py-2 rounded-lg transition-all text-sm font-medium hover:opacity-80"
                   style="background-color: #5D4E37; color: #D4C4B4; border: 2px solid #5D4E37;">
                <%= animal.name %>
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Location Input with Autocomplete -->
      <div data-controller="autocomplete" data-action="click@window->autocomplete#clickOutside">
        <label class="block text-sm font-semibold mb-2" style="color: #F5D67A;">Location</label>
        <div class="relative">
          <input type="text" name="place_query" id="place_query"
                 placeholder="Search for a location..."
                 autocomplete="off"
                 data-autocomplete-target="input"
                 data-action="input->autocomplete#search"
                 class="w-full px-4 py-3 rounded-xl transition-all"
                 style="background-color: #5D4E37; border: 1px solid #7D6D5D; color: #F5D67A;"
                 value="<%= params[:place_query] %>">
          <div data-autocomplete-target="results"
               class="hidden absolute z-10 w-full mt-1 rounded-xl shadow-lg max-h-60 overflow-auto"
               style="background-color: #5D4E37; border: 1px solid #7D6D5D;">
          </div>
        </div>
        <!-- Location map preview -->
        <div data-autocomplete-target="mapContainer" class="hidden mt-3 rounded-xl overflow-hidden" style="height: 150px;">
          <div data-autocomplete-target="map" style="width: 100%; height: 100%;"></div>
        </div>
        <%= f.hidden_field :start_latitude, data: { autocomplete_target: "latitude" } %>
        <%= f.hidden_field :start_longitude, data: { autocomplete_target: "longitude" } %>
      </div>

      <!-- Search Radius -->
      <div>
        <label class="block text-sm font-semibold mb-2" style="color: #F5D67A;">Search Radius</label>
        <div class="flex gap-2">
          <% [25, 50, 100, 150].each do |radius| %>
            <label class="cursor-pointer flex-1 select-btn">
              <input type="radio" name="trip[radius_km]" value="<%= radius %>"
                     class="peer hidden"
                     <%= 'checked' if @trip.radius_km == radius || (@trip.radius_km.nil? && radius == 50) %>>
              <div class="text-center py-2 rounded-lg transition-all text-sm font-medium"
                   style="background-color: #5D4E37; color: #D4C4B4; border: 2px solid #5D4E37;">
                <%= radius %>km
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Target Time (Optional) -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium mb-1" style="color: #D4C4B4;">Month (optional)</label>
          <%= f.select :target_month,
              options_for_select([['Any', nil]] + (1..12).map { |m| [Date::ABBR_MONTHNAMES[m], m] }, @trip.target_month),
              {},
              class: "w-full px-3 py-2 text-sm rounded-lg", style: "background-color: #5D4E37; border: 1px solid #7D6D5D; color: #F5D67A;" %>
        </div>
        <div>
          <label class="block text-xs font-medium mb-1" style="color: #D4C4B4;">Hour (optional)</label>
          <%= f.select :target_hour,
              options_for_select([['Any', nil]] + (0..23).map { |h| [format('%02d:00', h), h] }, @trip.target_hour),
              {},
              class: "w-full px-3 py-2 text-sm rounded-lg", style: "background-color: #5D4E37; border: 1px solid #7D6D5D; color: #F5D67A;" %>
        </div>
      </div>

      <!-- Submit -->
      <%= f.submit "Find Best Locations",
          class: "w-full py-3 font-semibold rounded-xl shadow-md transition-all cursor-pointer",
          style: "background-color: #F5D67A; color: #3D3225;" %>
    <% end %>
  </div>
</div>
