<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-center text-amber-800 mb-2">Trip Planner</h1>
  <hr class="border-amber-300 mb-6">

  <p class="text-gray-600 text-center mb-8">
    Plan your wildlife viewing trip. Enter a location and we'll find the best spots nearby.
  </p>

  <div class="bg-white rounded-xl shadow-lg p-6 border border-amber-100">
    <%= form_with model: @trip, local: true, class: "space-y-6" do |f| %>
      <% if @trip.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-700">
          <h3 class="font-semibold">Please fix the following errors:</h3>
          <ul class="list-disc list-inside mt-2">
            <% @trip.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-yellow-700">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <!-- Animal Selection -->
      <div>
        <label class="block text-sm font-semibold text-amber-800 mb-2">Select Animal</label>
        <div class="grid grid-cols-3 md:grid-cols-7 gap-3">
          <% @animals.each do |animal| %>
            <label class="cursor-pointer">
              <input type="radio" name="trip[animal_id]" value="<%= animal.id %>"
                     class="peer hidden"
                     <%= 'checked' if @trip.animal_id == animal.id || (@trip.animal_id.nil? && animal == @animals.first) %>>
              <div class="flex flex-col items-center p-3 rounded-lg border-2 border-gray-200 transition-all peer-checked:border-amber-500 peer-checked:bg-amber-50 hover:border-amber-300">
                <%= image_tag "#{animal.slug}-icon.png", alt: animal.name, class: "w-10 h-10 mb-1" %>
                <span class="text-xs font-medium text-gray-700"><%= animal.name %></span>
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Location Input -->
      <div>
        <label for="place_query" class="block text-sm font-semibold text-amber-800 mb-2">
          Starting Location
        </label>
        <input type="text" name="place_query" id="place_query"
               placeholder="e.g., Kruger National Park, South Africa"
               class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 transition-all"
               value="<%= params[:place_query] %>">
        <p class="text-xs text-gray-500 mt-1">Or enter coordinates below</p>
      </div>

      <!-- Coordinates (hidden by default) -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1">Latitude</label>
          <%= f.number_field :start_latitude, step: 0.0000001, placeholder: "-25.5",
              class: "w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-amber-500 focus:ring-2 focus:ring-amber-200" %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1">Longitude</label>
          <%= f.number_field :start_longitude, step: 0.0000001, placeholder: "28.5",
              class: "w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-amber-500 focus:ring-2 focus:ring-amber-200" %>
        </div>
      </div>

      <!-- Search Radius -->
      <div>
        <label class="block text-sm font-semibold text-amber-800 mb-2">Search Radius (km)</label>
        <div class="flex gap-3">
          <% [25, 50, 100, 150, 200].each do |radius| %>
            <label class="cursor-pointer flex-1">
              <input type="radio" name="trip[radius_km]" value="<%= radius %>"
                     class="peer hidden"
                     <%= 'checked' if @trip.radius_km == radius || (@trip.radius_km.nil? && radius == 50) %>>
              <div class="text-center py-2 rounded-lg border-2 border-gray-200 transition-all peer-checked:border-amber-500 peer-checked:bg-amber-50 hover:border-amber-300">
                <span class="font-medium"><%= radius %></span>
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Target Time (Optional) -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-amber-800 mb-2">Target Month (optional)</label>
          <%= f.select :target_month,
              options_for_select([['Any month', nil]] + (1..12).map { |m| [Date::MONTHNAMES[m], m] }, @trip.target_month),
              {},
              class: "w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-amber-500 focus:ring-2 focus:ring-amber-200" %>
        </div>
        <div>
          <label class="block text-sm font-semibold text-amber-800 mb-2">Target Hour (optional)</label>
          <%= f.select :target_hour,
              options_for_select([['Any time', nil]] + (0..23).map { |h| [format('%02d:00', h), h] }, @trip.target_hour),
              {},
              class: "w-full px-4 py-2 rounded-lg border border-gray-300 focus:border-amber-500 focus:ring-2 focus:ring-amber-200" %>
        </div>
      </div>

      <!-- Submit -->
      <div class="pt-4">
        <%= f.submit "Find Best Locations",
            class: "w-full py-3 px-6 bg-amber-500 hover:bg-amber-600 text-white font-semibold rounded-lg shadow-md transition-all cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
