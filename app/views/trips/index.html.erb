<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-center text-amber-800 mb-2">Recent Trip Plans</h1>
  <hr class="border-amber-300 mb-6">

  <%= link_to new_trip_path, class: "block w-full text-center py-3 bg-amber-500 hover:bg-amber-600 text-white font-semibold rounded-lg shadow-md transition-all mb-6" do %>
    Plan a New Trip
  <% end %>

  <% if @trips.any? %>
    <div class="space-y-4">
      <% @trips.each do |trip| %>
        <%= link_to trip_path(trip), class: "block bg-white rounded-xl shadow p-4 border border-amber-100 hover:shadow-lg transition-all" do %>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <%= image_tag "#{trip.animal.slug}-icon.png", alt: trip.animal.name, class: "w-10 h-10" %>
              <div>
                <p class="font-semibold text-amber-800"><%= trip.animal.name %></p>
                <p class="text-sm text-gray-500">
                  <%= trip.radius_km %>km radius
                  <% if trip.target_month %>
                    &bull; <%= Date::ABBR_MONTHNAMES[trip.target_month] %>
                  <% end %>
                </p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-2xl font-bold text-amber-600"><%= trip.likelihood_score || 0 %>%</p>
              <p class="text-xs text-gray-400"><%= trip.created_at.strftime('%b %d, %Y') %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-center text-gray-500 py-8">No trip plans yet. Create your first one!</p>
  <% end %>
</div>
