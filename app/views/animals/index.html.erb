<div class="max-w-7xl mx-auto px-4 py-6">
  <h1 class="text-3xl md:text-4xl font-bold text-center mb-8" style="color: #F5D67A;">Animal Info</h1>

  <!-- Horizontal scrolling cards container -->
  <div class="flex overflow-x-auto gap-6 pb-4 snap-x snap-mandatory">
    <% @animals.each do |animal| %>
      <div class="flex-none w-80 snap-start">
        <div class="rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow" style="background-color: #6B5D4D;">
          <!-- Animal Image -->
          <div class="h-48 overflow-hidden">
            <%= image_tag "animals/#{animal.slug}.jpg",
                alt: animal.name,
                class: "w-full h-full object-cover" %>
          </div>

          <!-- Animal Info -->
          <div class="p-4 space-y-3">
            <% if animal.animal_info %>
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-wide" style="color: #F5D67A;">Habitat</h3>
                <p class="text-sm" style="color: #D4C4B4;"><%= animal.animal_info.habitat %></p>
              </div>

              <div>
                <h3 class="text-sm font-semibold uppercase tracking-wide" style="color: #F5D67A;">Diet</h3>
                <p class="text-sm" style="color: #D4C4B4;"><%= animal.animal_info.diet %></p>
              </div>

              <div>
                <h3 class="text-sm font-semibold uppercase tracking-wide" style="color: #F5D67A;">Behavior</h3>
                <p class="text-sm" style="color: #D4C4B4;"><%= animal.animal_info.behavior_notes %></p>
              </div>
            <% end %>

            <!-- Stats -->
            <div class="flex justify-between pt-3" style="border-top: 1px solid #7D6D5D;">
              <div class="text-center">
                <p class="text-lg font-bold" style="color: #F5D67A;"><%= number_with_delimiter(animal.record_count) %></p>
                <p class="text-xs" style="color: #A89888;">Records</p>
              </div>
              <div class="text-center">
                <p class="text-lg font-bold" style="color: #F5D67A;"><%= animal.range_span_km %> km</p>
                <p class="text-xs" style="color: #A89888;">Range Span</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Scroll hint -->
  <p class="text-center text-sm mt-4" style="color: #A89888;">
    Scroll horizontally to see all animals
  </p>
</div>
