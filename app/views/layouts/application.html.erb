<!DOCTYPE html>
<html>
  <head>
    <title>Now Now Wildlife Finder</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      body { background-color: #5D4E37 !important; }
      .nav-text { color: #F5D67A !important; }
      .nav-icon { color: #F5D67A !important; }
      .nav-item:hover .nav-icon, .nav-item:hover .nav-text { color: #FFE9A0 !important; }
      .nav-item.active .nav-icon, .nav-item.active .nav-text { color: #FFE9A0 !important; }
    </style>
  </head>

  <body class="font-[Montserrat] min-h-screen flex flex-col">
    <!-- Header -->
    <header class="shadow-sm sticky top-0 z-50" style="background-color: #4A3F2F;">
      <div class="max-w-7xl mx-auto px-4 py-3">
        <%= link_to root_path, class: "flex items-center gap-3 hover:opacity-80 transition-opacity" do %>
          <%= image_tag "logo-brown.png", alt: "NowNow", class: "w-10 h-10" %>
          <div>
            <h1 class="text-lg font-bold leading-tight" style="color: #F5D67A;">NowNow</h1>
            <p class="text-xs leading-tight" style="color: #E8D5B0;">Wildlife Finder</p>
          </div>
        <% end %>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 pb-20">
      <%= yield %>
    </main>

    <!-- Footer Navigation -->
    <footer class="fixed bottom-0 left-0 right-0 shadow-lg z-50" style="background-color: #4A3F2F;">
      <nav class="w-full px-4">
        <div class="flex justify-between items-center py-2 max-w-md mx-auto">
          <%= link_to animals_path,
              class: "nav-item flex flex-col items-center px-4 py-2 rounded-lg transition-all #{current_page?(animals_path) ? 'active' : ''}" do %>
            <svg class="w-6 h-6 nav-icon" fill="currentColor" viewBox="0 0 24 24">
              <!-- Lion head icon -->
              <path d="M12 2C9.5 2 7.5 3.5 7 5.5C5 5 3 6.5 3 9c0 1.5.5 2.5 1.5 3.5C3.5 13.5 3 15 3 16.5c0 2 1 3.5 2.5 4C6 22 8.5 23 12 23s6-1 6.5-2.5c1.5-.5 2.5-2 2.5-4 0-1.5-.5-3-1.5-4C20.5 11.5 21 10.5 21 9c0-2.5-2-4-4-3.5C16.5 3.5 14.5 2 12 2zm-3 7c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm6 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm-3 3c1.5 0 2.5 1 2.5 2 0 .5-.5 1-1 1-.5-.5-1-.5-1.5-.5s-1 0-1.5.5c-.5 0-1-.5-1-1 0-1 1-2 2.5-2z"/>
            </svg>
            <span class="text-xs mt-1 font-medium nav-text">Animals</span>
          <% end %>

          <%= link_to sightings_path,
              class: "nav-item flex flex-col items-center px-4 py-2 rounded-lg transition-all #{current_page?(sightings_path) ? 'active' : ''}" do %>
            <svg class="w-6 h-6 nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
            </svg>
            <span class="text-xs mt-1 font-medium nav-text">Map</span>
          <% end %>

          <%= link_to activities_path,
              class: "nav-item flex flex-col items-center px-4 py-2 rounded-lg transition-all #{controller_name == 'activities' ? 'active' : ''}" do %>
            <svg class="w-6 h-6 nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <span class="text-xs mt-1 font-medium nav-text">Activity</span>
          <% end %>

          <%= link_to new_trip_path,
              class: "nav-item flex flex-col items-center px-4 py-2 rounded-lg transition-all #{controller_name == 'trips' ? 'active' : ''}" do %>
            <svg class="w-6 h-6 nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="text-xs mt-1 font-medium nav-text">Planner</span>
          <% end %>
        </div>
      </nav>
    </footer>
  </body>
</html>
